# ============================================================================
# Environment variables — Polymarket Up/Down bot
# ============================================================================
#
# NOTHING AUTO-LOADS THIS FILE. It is documentation. Export these in your
# shell, or use systemd `EnvironmentFile=`, or your process manager's
# equivalent. (dotenv-style loading is deliberately not implemented.)
#
# For a VPS deployment, the systemd EnvironmentFile template lives at
# deploy/bot.env.example (paper-only; live secrets commented out). See the
# README "Deployment (VPS)" section.
#
# Secrets are read ONLY from the environment — never from config files.
# Empty values are treated as absent.

# --- Secrets (BOT_SECRET_* is excluded from config-override parsing) --------

# Dashboard auth token. Required if dashboard.bind is not loopback.
#BOT_SECRET_DASHBOARD_TOKEN=

# Polymarket API credentials + signing key. Required only for live mode.
#BOT_SECRET_PM_API_KEY=
#BOT_SECRET_PM_API_SECRET=
#BOT_SECRET_PM_API_PASSPHRASE=
#BOT_SECRET_PM_PRIVATE_KEY=

# Live-arming gate 2: must contain the exact phrase below (gate 1 is
# live.enabled in config; gate 3 is the dashboard arm action).
#   arm-live-i-accept-real-money-losses
#BOT_SECRET_LIVE_CONFIRM=

# --- Non-secret controls -----------------------------------------------------

# Where the config files live (default: ./config). The --config-dir CLI flag
# takes precedence over this.
#BOT_CONFIG_DIR=config

# Log filter (overrides log.default_filter), standard tracing directives:
#RUST_LOG=info,engine=debug,feed_clob=trace

# Any config value can be overridden as BOT_<SECTION>__<KEY> (double
# underscore between path segments). Examples:
#BOT_PAPER__STARTING_CAPITAL=25000
#BOT_RISK__DAILY_STOP_LOSS=100
#BOT_DASHBOARD__BIND=127.0.0.1:9090
