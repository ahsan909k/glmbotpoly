# EVAL config overlay — Day-1 sizing ($150/window). Signed off 2026-07-15.
# 4-DAY accelerated eval (compressed from 14 days; all verdicts preserved).
#
# Copy to /etc/bot/config/bot.local.toml at cutover (layered OVER
# config/default.toml). Inspect the merged result before starting:
#   sudo -u bot /opt/bot/bin/bot check-config --config-dir /etc/bot/config
#
# DAY-2 sizing bump (only if the day-1 infra gate passes): change the three lines
# marked [DAY-2] below, then `sudo systemctl restart bot` (graceful drain).
# Every knob here is STRUCTURAL / restart-only — none is runtime `set-param`able.

[log]
dir = "/var/lib/bot/data/logs"

[journal]
dir = "/var/lib/bot/data/journal"                 # gzip segments (source of truth)
sqlite_path = "/var/lib/bot/data/journal.sqlite"  # queryable index (+ -wal/-shm)
depth_dir = "/var/lib/bot/data/depth"             # (unused when depth capture is off)
# 10 d age over-covers the 4-day eval, so the sqlite index holds the whole run for
# a direct day-4 report; the 30 GiB cap is a disk backstop (won't bind at ~2.5 GB/day
# × 4 d); the nightly S3-backup prunes local raw segments >7 d confirmed in S3. The
# daily digests archived to S3 are the authoritative eval record regardless.
retention_max_age_ms = 864000000                  # 10 days
retention_max_total_bytes = 32212254720           # 30 GiB disk backstop (>= 128 MiB)

[run]
# Skip the boot-time journal replay: with a 1.3 GB+ journal it takes ~12 min and
# rebuilds state that is currently DISCARDED (the paper wallet resets per session
# regardless), so it is pure startup cost — and it would blow upgrade.sh's ARMED
# poll and trigger an auto-rollback. Recording is unaffected.
replay_journal_on_start = false

[paper]
starting_capital = 50000                          # $50k bankroll (both phases)
# venue_taker_delay_ms stays 250 (Polymarket's, not ours — do NOT change).
# Set placement/cancel latency AFTER the `bot latency` rebench on the VPS
# (Phase 1.4): mean_ms = measured clob REST p50, jitter_ms = p95 − p50.
[paper.placement_latency]
mean_ms = 24        # measured VPS clob REST p50 = 23.5 ms (rebench 2026-07-15)
jitter_ms = 8       # one-sided-up; [24, 32] covers p95 26 → p99 29
[paper.cancel_latency]
mean_ms = 24        # cancel round-trip is the same CLOB REST path
jitter_ms = 8

[risk]
shadow_loss_stops = true      # PAPER EVAL: loss stops (DailyStop/WindowLoss) record + flag,
                              # never halt. Operational breakers stay HARD.
daily_stop_loss = 1000        # 2% of $50k — SHADOW (computed, journaled, never halts).
max_open_notional = 5000      # REAL backstop (~4× peak instantaneous deployment ~$1.2k).
feed_staleness_grace_ms = 1500 # eu-west-1 direct-Binance Mid path stalls p95 ~1.4s (measured at the
                              # feed task, WS stable): the 500ms bound measures NATURAL Mid cadence,
                              # not network health. FeedStale then fires only on genuine >2s feed
                              # deaths; the model's own graceful staleness handles brief stalls.
                              # (Reversed the strict-0; see the 2026-07-16 Decisions Log entry.)
book_staleness_dwell_ms = 1500 # filter transient CLOB book Stale/Crossed churn during six-series
                              # rollovers; a SUSTAINED book outage past 1500 ms STILL trips FeedStale.
# FairVsMid two-tier (2026-07-16, from the clean post-#42P01 episode measurement).
# SLOW = sanity net for moderate persistent gaps; FAST = catastrophic gap caught fast.
# Healthy lead-lag self-resolves: p99 episode duration 82s@0.10 / 54s@0.12 / 23s@0.15
# (none <=12s -> rule fallback 0.10/23s). Healthy NEVER sustains >0.40 (the >0.40 tail
# is isolated 1-second model spikes) -> fast bound 0.40/3s catches a broken fair in 3s.
sanity_bound = 0.10                  # SLOW bound (fallback)
sanity_bound_duration_ms = 23000     # SLOW dwell (fallback; healthy lead-lag mostly resolves under it)
sanity_bound_fast = 0.40             # FAST bound (measured sustained ceiling 0.35 + margin; literal 2x-p99.9 = 0.64 was single-tick-inflated)
sanity_bound_duration_fast_ms = 3000 # FAST dwell (catastrophic gap in seconds, not 23)

[feeds]
binance_depth_capture = false   # research depth capture stays on the Windows box (division of labor).

[shadow]
enable = true                 # champion-model observer (required by model_taker).
model_path = "/opt/bot/models/model_dir10_full.txt"
model_meta_path = "/opt/bot/models/model_dir10_full.meta.json"
shadow_dir = "/var/lib/bot/data/shadow"

[model_taker]
enable = true                 # champion dir10 model taker (per-window, all four M5/M15).
budget_per_window = 10        # [DAY-2] -> 100

[engine.defaults]
clip_size_shares = 60                     # hard per-order cap (maker levels + taker clips ≤ 60).
touch_size = 40                           # ~$152 two-sided instantaneous resting (≈ $19/order).
ladder_size_per_level = 40
ladder_levels = 3
maker_deployment_budget_per_window = 150  # [DAY-2] -> 1000  (cumulative gross-buy $/window)
max_worst_case_loss_per_window = 95       # constant both phases (risk = net inventory, not churn)
soft_cap_excess_shares = 200
hard_cap_excess_shares = 400
taker_budget_per_window = 10              # [DAY-2] -> 100  (momentum + late, cumulative $)

# Disable the 1h series (2026-07-16). The fair-value model is OUT-OF-SCOPE for 1h:
# z = ln(S/K)/(sigma*sqrt(tau)) with tau up to 3600s amplifies any sigma error, and
# 1h markets resolve on a Binance CANDLE, not Chainlink (the model's ground truth),
# so the model's 1h p_up chronically diverges from the book (BTC-1h ~76% of the time
# above the 0.10 bound). Because FairVsMid is a GLOBAL breaker, that OOD divergence
# trips a sustained halt that stands down the WHOLE engine (incl. healthy M5/M15).
# The plan already treats 1h conclusions as provisional (~96 windows/series), so the
# eval runs the four M5/M15 series only. (Model taker/shadow are M5/M15-scoped too.)
[engine.series.BTC-1h]
enabled = false
[engine.series.ETH-1h]
enabled = false

# Dashboard stays on loopback (default); reach it via the SSH tunnel:
#   ssh -N -L 8080:localhost:8080 ubuntu@54.154.134.102
