# systemd EnvironmentFile for the bot — copy to /etc/bot/bot.env, mode 0600.
#
#   sudo install -m 0600 deploy/bot.env.example /etc/bot/bot.env
#   sudo chown root:bot /etc/bot/bot.env        # systemd reads it as root pre-drop
#
# FORMAT (systemd EnvironmentFile, NOT a shell script):
#   - one KEY=value per line, no `export`, `#` comments only at line start
#   - NO shell expansion: `$VAR` / `${VAR}` are literal, not expanded
#   - do not quote values unless the value itself contains spaces
#
# PAPER PHASE: no live keys. Secrets are read ONLY from the environment (never
# from TOML); empty values are treated as absent.

# --- Logging (overrides log.default_filter) ---
RUST_LOG=info

# --- Dashboard auth ---
# ONLY required for a NON-loopback bind (the boot self-check refuses to start a
# public bind without it). The recommended posture keeps the dashboard on
# loopback (default 127.0.0.1:8080) reached via an SSH tunnel, which needs NO
# token. Uncomment + set a long random token only for the public-bind option:
#   openssl rand -hex 32
#BOT_SECRET_DASHBOARD_TOKEN=

# --- Optional config overrides (alternative to bot.local.toml) ---
# Absolute data paths can be set here instead of in bot.local.toml. The leaf
# key's single underscore is preserved (BOT_JOURNAL__SQLITE_PATH maps to
# journal.sqlite_path). Prefer bot.local.toml so `bot check-config` shows them.
#BOT_JOURNAL__DIR=/var/lib/bot/data/journal
#BOT_JOURNAL__SQLITE_PATH=/var/lib/bot/data/journal.sqlite
#BOT_LOG__DIR=/var/lib/bot/data/logs

# ============================================================================
# LIVE TRADING — DO NOT UNCOMMENT until the live phase is explicitly approved.
# These spend REAL money. Kept here only as documentation. Live also needs
# `[live].enabled = true` in config (gate 1) and the dashboard arm (gate 3).
# ============================================================================
#BOT_SECRET_PM_API_KEY=
#BOT_SECRET_PM_API_SECRET=
#BOT_SECRET_PM_API_PASSPHRASE=
#BOT_SECRET_PM_PRIVATE_KEY=
#BOT_SECRET_LIVE_CONFIRM=arm-live-i-accept-real-money-losses
